#!/usr/bin/env node
import { Command } from 'commander';
import boxen from 'boxen';
import chalk from 'chalk';
import { exit } from 'process';
import dotenv from 'dotenv';
import { fileURLToPath } from 'url';
import { dirname } from 'path';
import db from '../db.js';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);

const info = chalk.cyan;
const success = chalk.green;
const warning = chalk.keyword('orange');
const danger = chalk.bold.red;
const important = chalk.yellow;
const CONSOLE_DIR_OPTIONS = { showHidden: true, depth: Infinity, colors: true, maxArrayLength: Infinity };

process.chdir(__dirname + '/..'); //set working directory to service dir

dotenv.config();

////////////////////////////////////////////////////////////////////////////////////

const greeting = warning.bold(`W4H CLI`);
const boxenOptions = {
	padding: 1,
	//margin: 1,
	borderStyle: 'round',
	borderColor: '#FFA500',
	//backgroundColor: ''
};
const msgBox = boxen(greeting, boxenOptions);

const program = new Command();

program.version('0.0.1').description(msgBox);

program
	.command('configuration')
	.alias('conf')
	.description('print configuration')
	.action(() => {
		let connection = JSON.parse(process.env.DB_CONNECTION);
		delete connection.user;
		delete connection.password;
		console.log(important('cwd:', process.cwd()));
		console.log(important('path:', __dirname + '/' + program._name));
		console.log(info('configuration:'));
		console.table(connection);
	});

///////////////////////////////////////////////////////////////////////

program.parse(process.argv);