#!/usr/bin/env node
import { Command } from 'commander';
import boxen from 'boxen';
import chalk from 'chalk';
import { exit } from 'process';
import dotenv from 'dotenv';
import { fileURLToPath } from 'url';
import { dirname } from 'path';
import readline from 'readline';
import bcrypt from 'bcrypt';
import db from '../db.js';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);

const info = chalk.cyan;
const success = chalk.green;
const warning = chalk.keyword('orange');
const danger = chalk.bold.red;
const important = chalk.yellow;

process.chdir(__dirname + '/..');
dotenv.config();

////////////////////////////////////////////////////////////////////////////////////

const greeting = warning.bold(`W4H CLI`);
const boxenOptions = {
  padding: 1,
  borderStyle: 'round',
  borderColor: '#FFA500',
};
const msgBox = boxen(greeting, boxenOptions);

const program = new Command();
program.version('0.0.1').description(msgBox);

////////////////////////////////////////////////////////////////////////////////////

program
  .command('configuration')
  .alias('conf')
  .description('print configuration')
  .action(() => {
    const connection = {
      host: process.env.DB_HOST,
      port: process.env.DB_PORT,
      database: process.env.DB_DATABASE,
    };
    console.log(important('cwd:', process.cwd()));
    console.log(important('path:', __dirname + '/' + program._name));
    console.log(info('configuration:'));
    console.table(connection);
  });

////////////////////////////////////////////////////////////////////////////////////

program
  .command('reset-password')
  .alias('rp')
  .description('Break-glass: reset an admin password (HIPAA — must be documented)')
  .action(async () => {
    const rl = readline.createInterface({ input: process.stdin, output: process.stdout });

    const ask = (question) => new Promise(resolve => rl.question(question, resolve));

    const askHidden = (question) => new Promise(resolve => {
      process.stdout.write(question);
      process.stdin.setRawMode(true);
      process.stdin.resume();
      process.stdin.setEncoding('utf8');
      let password = '';
      const onData = (ch) => {
        ch = ch.toString('utf8');
        if (ch === '\n' || ch === '\r' || ch === '\u0004') {
          process.stdout.write('\n');
          process.stdin.setRawMode(false);
          process.stdin.pause();
          process.stdin.removeListener('data', onData);
          resolve(password);
        } else if (ch === '\u0003') {
          process.stdout.write('\n');
          console.log(warning('Aborted.'));
          process.exit(0);
        } else if (ch === '\u007f') {
          password = password.slice(0, -1);
        } else {
          password += ch;
        }
      };
      process.stdin.on('data', onData);
    });

    console.log(boxen(danger('⚠  BREAK-GLASS PROCEDURE'), { padding: 1, borderStyle: 'round', borderColor: 'red' }));
    console.log(danger('HIPAA Notice: This action will be audited. Unauthorized use is a HIPAA violation.'));
    console.log(warning('Do NOT pass passwords as command-line arguments — use the prompts below only.\n'));

    const adminName = await ask(info('Your name (administrator performing reset): '));
    const reason = await ask(info('Reason for reset: '));

    if (!adminName.trim() || !reason.trim()) {
      console.log(danger('\n❌ Administrator name and reason are required for the audit trail.'));
      rl.close();
      process.exit(1);
    }

    const email = await ask(info('Email address of account to reset: '));

    const userRes = await db.query(
      `SELECT id, email, name, role FROM w4h.users WHERE email = $1`,
      [email.trim()]
    );

    if (userRes.rowCount === 0) {
      console.log(danger('\n❌ No user found with that email.'));
      rl.close();
      process.exit(1);
    }

    const user = userRes.rows[0];
    console.log(success(`\nFound: ${user.name} (${user.email}) — role: ${user.role}`));

    const confirm = await ask(warning('Confirm reset? (yes/no): '));
    if (confirm.trim().toLowerCase() !== 'yes') {
      console.log(warning('Aborted.'));
      rl.close();
      process.exit(0);
    }

    const newPassword = await askHidden(info('New password: '));
    const confirmPassword = await askHidden(info('Confirm new password: '));

    if (newPassword !== confirmPassword) {
      console.log(danger('\n❌ Passwords do not match.'));
      rl.close();
      process.exit(1);
    }

    if (newPassword.length < 12) {
      console.log(danger('\n❌ Password must be at least 12 characters.'));
      rl.close();
      process.exit(1);
    }

    const rounds = parseInt(process.env.BCRYPT_ROUNDS) || 12;
    const hash = await bcrypt.hash(newPassword, rounds);

    await db.query(
      `UPDATE w4h.users SET password = $1, updated_at = NOW() WHERE email = $2`,
      [hash, email.trim()]
    );

    const timestamp = new Date().toISOString();

    // Write audit log — fall back to local file if table unavailable
    try {
      await db.query(
        `INSERT INTO w4h.audit_log (user_id, action, resource_type, resource_id, details)
         VALUES (NULL, 'BREAK_GLASS_PASSWORD_RESET', 'user', $1, $2)`,
        [String(user.id), JSON.stringify({ via: 'cli', operator: adminName.trim(), reason: reason.trim(), email: user.email })]
      );
    } catch {
      const { appendFileSync } = await import('fs');
      const logEntry = `${timestamp} | BREAK_GLASS_PASSWORD_RESET | by: ${adminName.trim()} | target: ${email.trim()} | reason: ${reason.trim()}\n`;
      appendFileSync('./break-glass-audit.log', logEntry);
      console.log(warning('\n⚠️  Could not write w4h.audit_log — logged to break-glass-audit.log instead.'));
    }

    console.log(success(`\n✅ Password reset successfully for ${user.email}`));
    console.log(info(`📋 Audit entry recorded at ${timestamp}`));
    console.log(important('\nREMINDER: Document this action in your HIPAA incident log:'));
    console.log(important(`  Administrator : ${adminName.trim()}`));
    console.log(important(`  Target        : ${email.trim()}`));
    console.log(important(`  Reason        : ${reason.trim()}`));
    console.log(important(`  Timestamp     : ${timestamp}\n`));

    rl.close();
    process.exit(0);
  });

////////////////////////////////////////////////////////////////////////////////////

program
  .command('promote-super-admin [email]')
  .alias('psa')
  .description('Break-glass: make an account a Super admin, or invite a new one (audited)')
  .action(async (emailArg) => {
    // Queue lines so answers piped from a script are not lost between prompts.
    const rl = readline.createInterface({ input: process.stdin });
    const lines = [];
    const waiters = [];
    let closed = false;
    rl.on('line', (line) => (waiters.length ? waiters.shift()(line) : lines.push(line)));
    rl.on('close', () => { closed = true; while (waiters.length) waiters.shift()(''); });
    const ask = (question) => {
      process.stdout.write(question);
      if (lines.length) return Promise.resolve(lines.shift());
      if (closed) return Promise.resolve('');
      return new Promise(resolve => waiters.push(resolve));
    };
    const fail =(msg) => { console.log(danger(`\n❌ ${msg}`)); rl.close(); process.exit(1); };

    console.log(boxen(danger('⚠  BREAK-GLASS PROCEDURE'), { padding: 1, borderStyle: 'round', borderColor: 'red' }));
    console.log(danger('HIPAA Notice: granting Super admin is audited. Unauthorized use is a HIPAA violation.\n'));

    const operator = (await ask(info('Your name (person performing this change): '))).trim();
    const reason = (await ask(info('Reason: '))).trim();
    if (!operator || !reason) fail('Your name and a reason are required for the audit trail.');

    const email = (emailArg || await ask(info('Email of the account to make Super admin: '))).trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) fail('That is not a valid email address.');

    // Loaded after dotenv so INVITE_TTL_HOURS / APP_URL come from .env.
    const { appBaseUrl, createInvitation, inviteAcceptUrl } = await import('../lib/invitations.js');

    const found = await db.query(
      `SELECT u.id, u.name, u.email, u.role, u.status,
         (SELECT COUNT(*)::int FROM w4h.team_members tm WHERE tm.user_id = u.id) AS team_count
       FROM w4h.users u WHERE lower(u.email) = lower($1)`,
      [email]
    );
    const user = found.rows[0];
    let userId;
    let action;

    if (user) {
      console.log(success(`\nFound: ${user.name || '(no name)'} (${user.email}) — role: ${user.role}, status: ${user.status}`));
      if (user.status === 'discontinued') fail('This account is discontinued. Resume it first.');
      if (user.role === 'super_admin' && user.status !== 'invited') {
        console.log(success('Already an active Super admin. Nothing to do.'));
        rl.close();
        process.exit(0);
      }
      if (user.team_count > 0) {
        fail(`This account belongs to ${user.team_count} team(s), and Super admins cannot be team members. `
          + 'Use a separate email for the Super admin account.');
      }
      action = 'promote';
      userId = user.id;
    } else {
      console.log(warning(`\nNo account for ${email}. A new Super admin account will be created with an invitation link.`));
      action = 'create';
    }

    const needsInvite = action === 'create' || user.status === 'invited';
    if (needsInvite && !appBaseUrl()) fail('APP_URL is not set in .env, so no invitation link can be made.');

    const confirm = await ask(warning(`Make ${email} a Super admin? (yes/no): `));
    if (confirm.trim().toLowerCase() !== 'yes') {
      console.log(warning('Aborted.'));
      rl.close();
      process.exit(0);
    }

    if (action === 'create') {
      const ins = await db.query(
        `INSERT INTO w4h.users (name, email, password, role, status, can_create_teams)
         VALUES ($1, $1, NULL, 'super_admin', 'invited', false) RETURNING id`,
        [email]
      );
      userId = ins.rows[0].id;
    } else {
      await db.query(
        `UPDATE w4h.users SET role = 'super_admin', can_create_teams = false, updated_at = NOW() WHERE id = $1`,
        [userId]
      );
    }

    const inviteUrl = needsInvite ? inviteAcceptUrl(await createInvitation(userId, null)) : null;
    const timestamp = new Date().toISOString();
    const details = { via: 'cli', operator, reason, email, previous_role: user?.role ?? null, created: action === 'create' };

    try {
      await db.query(
        `INSERT INTO w4h.audit_log (user_id, action, resource_type, resource_id, details)
         VALUES (NULL, 'user.break_glass.super_admin_granted', 'user', $1, $2)`,
        [String(userId), JSON.stringify(details)]
      );
    } catch {
      const { appendFileSync } = await import('fs');
      appendFileSync('./break-glass-audit.log',
        `${timestamp} | SUPER_ADMIN_GRANTED | by: ${operator} | target: ${email} | reason: ${reason}\n`);
      console.log(warning('\n⚠️  Could not write w4h.audit_log — logged to break-glass-audit.log instead.'));
    }

    console.log(success(`\n✅ ${email} is now a Super admin.`));
    if (inviteUrl) {
      console.log(important('Send this invitation link to them securely (they set their own password):'));
      console.log(`  ${inviteUrl}`);
    } else {
      console.log(info('They keep their current password; Super admin applies on their next sign-in.'));
    }
    console.log(important('\nREMINDER: Document this action in your HIPAA incident log:'));
    console.log(important(`  Administrator : ${operator}`));
    console.log(important(`  Target        : ${email}`));
    console.log(important(`  Reason        : ${reason}`));
    console.log(important(`  Timestamp     : ${timestamp}\n`));

    rl.close();
    process.exit(0);
  });

////////////////////////////////////////////////////////////////////////////////////

program
  .command('seed-docs')
  .description('Create/refresh the w4h-sample database with synthetic screenshot users')
  .option('--reset', 'Drop and recreate w4h-sample (does not touch DB_DATABASE)')
  .action(async (opts) => {
    try {
      const { seedDocsFixtures } = await import('../lib/seed-docs-fixtures.js');
      const result = await seedDocsFixtures({ reset: opts.reset });
      console.log(success(`Docs sample database ready: ${result.database}`));
      if (result.workingDatabase && result.workingDatabase !== result.database) {
        console.log(info(`  Left untouched ${result.workingDatabase} (DB_DATABASE in .env)`));
      } else if (result.workingDatabase === result.database) {
        console.log(warning('  Note: .env DB_DATABASE already is the sample DB. Prefer w4h-db in .env and npm run start:sample for captures.'));
      }
      console.log(info(`  Super admin  ${result.users.superadmin.email}`));
      console.log(info(`  Admin        ${result.users.admin.email}`));
      console.log(info(`  User         ${result.users.user.email}`));
      console.log(info(`  Team         ${result.team.name} (${result.team.slug})`));
      console.log(info(`  Project      ${result.project.name} (${result.project.slug})`));
      if (result.passwordWasDefault) {
        console.log(warning('  Password     documented default in w4h-docs/dev/docs-fixtures.md'));
      } else {
        console.log(warning('  Password     W4H_DOCS_PASSWORD (not printed)'));
      }
      console.log(important('\nServe the sample without changing .env:'));
      console.log(important('  npm run start:sample'));
      process.exit(0);
    } catch (err) {
      console.error(danger(err.message || err));
      process.exit(1);
    }
  });

////////////////////////////////////////////////////////////////////////////////////

program.parse(process.argv);