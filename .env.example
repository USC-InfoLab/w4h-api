NODE_ENV=development

# JWT Token Secret (auto-generated during initial setup)
TOKEN_SECRET=

PORT=2026

# Debug mode (set to "true" to enable verbose logging)
W4H_DEBUG=

# Database connection settings -- leave as is for initial setup
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=w4h-db
DB_USER=
DB_PASSWORD=

# Local w4h documentation files (from w4h-documentation repo).
# This is used for auto-importing docs into the database when the W4H database is initialized.
DOCS_REPO_PATH=../w4h-documentation
