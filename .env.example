NODE_ENV=development

# JWT Token Secret (auto-generated during initial setup)
TOKEN_SECRET=

PORT=2026

# Debug mode (set to "true" to enable verbose logging)
W4H_DEBUG=

# Database connection settings -- leave as is for initial setup
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=w4h-db
DB_USER=
DB_PASSWORD=

# Markdown documentation repo (optional). When set and content/ has .md files,
# initial DB seed uses this tree + documentation-configuration.yml instead of data/docs.sql.
DOCS_REPO_DIR=../w4h-docs

# Optional override for YAML path (default: documentation-configuration.yml in w4h-api root)
# DOCS_CONFIG_FILE=documentation-configuration.yml
