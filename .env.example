NODE_ENV=development

# Debug mode (set to "true" to enable verbose logging)
W4H_DEBUG=

# Public app base URL (invite links, docs {{APP_URL}} substitution). Example: http://localhost:5173
APP_URL=

# Public API base URL (docs {{API_URL}} for /docs-media screenshots). Defaults to http://localhost:$PORT
# API_PUBLIC_URL=http://localhost:2026

# Invitation link lifetime in hours (default 72)
INVITE_TTL_HOURS=72

PORT=2026

# JWT Token Secret (auto-generated during initial setup)
TOKEN_SECRET=

# Optional wrap secret for stored API keys (falls back to TOKEN_SECRET)
# API_KEY_WRAP_SECRET=

# Optional platform Anthropic key for provisioned AI chat (Super admin can also store one in Settings)
# ANTHROPIC_API_KEY=

# HIPAA compliance rounds for bcrypt password hashing (default is 12)
BCRYPT_ROUNDS=12

# Support / notifications
HELP_EMAIL=

# Usage tracking for app usageanalytics. This is not for auditing or HIPAA compliance.
USAGE_TRACKING=false

# Markdown documentation files (from w4h-docs repo).
# Used when initializing the W4H database to auto-import docs into the database.
DOCS_REPO_PATH=../w4h-docs

# SMTP settings (used for invitation/notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=

# Largest published notebook report, in bytes (default 8388608 = 8 MB).
# REPORT_MAX_BYTES=8388608

# Request access (USC-only). Comma-separated, exact email domains allowed on the public form.
ACCESS_REQUEST_ALLOWED_DOMAINS=usc.edu
# Optional hourly limits per IP / per email on POST /access-requests.
# ACCESS_REQUEST_MAX_PER_IP=5
# ACCESS_REQUEST_MAX_PER_EMAIL=3

# Database connection settings
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=w4h-db
DB_USER=
DB_PASSWORD=
