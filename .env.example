NODE_ENV=development

# JWT Token Secret (auto-generated during initial setup)
TOKEN_SECRET=

PORT=2026

# Debug mode (set to "true" to enable verbose logging)
W4H_DEBUG=

# Database connection settings -- leave as is for initial setup
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=w4h-db
DB_USER=
DB_PASSWORD=

# Local docs repo (optional; see lib/docs-repo-import.js for tarball defaults).
DOCS_REPO_DIR=../w4h-documentation

# Doc import: Mermaid → SVG via Playwright Chromium. Set to 1 to skip (HTML keeps div.mermaid source).
# After npm install: npm run install:browsers   (or: npx playwright install chromium)
# W4H_MERMAID_DISABLE=
